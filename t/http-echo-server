#!/usr/bin/env python3

# Minimal HTTP/1.1 server used to test the proxy's request path. It reads
# the full request body and answers 200 with the number of body bytes it
# received (as plain text). A large POST therefore checks both that the
# proxy forwards request bodies and that bodies larger than one TCP
# segment are split correctly on the way out.

import http.server
import socketserver


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(n)
        payload = str(len(body)).encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *args):
        pass


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True


Server(("0.0.0.0", 8000), Handler).serve_forever()
