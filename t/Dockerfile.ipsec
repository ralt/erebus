# A strongSwan IKEv2/IPsec responder with nginx behind it, used as the
# reference server for erebus' IPsec data-plane tests. Mirrors the role the
# kylemanna/openvpn image plays for the OpenVPN tests.
#
# nginx listens on the server's in-tunnel address (10.10.0.1); the erebus
# client is assigned an address out of strongSwan's pool (10.9.0.0/24) and
# reaches nginx through the ESP tunnel.

FROM alpine:3.20

RUN apk add --no-cache strongswan nginx python3 curl iproute2 bash

# alpine's nginx includes /etc/nginx/http.d/*.conf
COPY nginx.conf /etc/nginx/http.d/default.conf

COPY fixtures/ipsec/swanctl.conf /etc/swanctl/swanctl.conf
COPY fixtures/ipsec/start-ipsec /usr/bin/start-ipsec
RUN chmod +x /usr/bin/start-ipsec

CMD ["sleep", "infinity"]
